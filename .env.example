# Copy to .env for production/local custom configuration. Do not commit .env.
CHECKIN_ENV=development
EVENT_NAME=導生晚宴
# Optional, Taipei time. Use quotes when values contain spaces or #.
EVENT_STARTS_AT=
EVENT_LOCATION=
EVENT_ORGANIZER=
EVENT_CONTACT=
EVENT_NOTICE=
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Production: CHECKIN_ENV=production, HTTPS URL, random SECRET_KEY >= 32 characters.
# python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# Prefer: python -m checkin.setup_event (masked password input; no plaintext stored).
# Only used when no user accounts exist. Existing accounts are never reset on startup.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD_HASH=
# Empty/unset uses instance/checkin.sqlite3. Demo uses instance/demo.sqlite3.
# Set an ABSOLUTE private path only when changing the default.
# DATABASE_PATH=/data/checkin.sqlite3
# 1 only behind the single trusted Caddy proxy; keep 0 for local Flask.
TRUST_PROXY=0
