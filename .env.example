# Copy to .env for production/local custom configuration. Do not commit .env.
CHECKIN_ENV=development
EVENT_NAME=導生晚宴
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Production: CHECKIN_ENV=production, HTTPS URL, random SECRET_KEY >= 32 characters.
# python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# Empty/unset uses instance/checkin.sqlite3. Demo uses instance/demo.sqlite3.
# Set an ABSOLUTE private path only when changing the default.
# DATABASE_PATH=/data/checkin.sqlite3
# 1 only behind the single trusted Caddy proxy; keep 0 for local Flask.
TRUST_PROXY=0
