{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# No access log containing ticket credentials, request bodies, or sensitive headers.
	log {
		output discard
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy app:8000 {
		# Do not trust X-Forwarded-* supplied by the public client.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
